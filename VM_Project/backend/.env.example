# ==============================================================================
# VM_project - Insurance Customer Intelligence Platform
# Environment Configuration
# ==============================================================================

# Application
APP_NAME="VM_project - Insurance Customer Intelligence Platform"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (Frontend origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
# Default: SQLite (local development with aiosqlite for async)
DATABASE_URL="sqlite+aiosqlite:///./vm_project.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/vm_project"

# Synchronous DB URL (used for database seeding and migrations)
SYNC_DATABASE_URL="sqlite:///./vm_project.db"
# SYNC_DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/vm_project"

# Google Gemini AI Configuration (Modern google-genai SDK)
GEMINI_API_KEY="your-gemini-api-key-here"
# Currently supported models: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_ANALYSIS_MODEL="gemini-3.8-flash"
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# AI Proactive Engine Settings
PROACTIVE_SCAN_BATCH_SIZE=25
ATTENTION_SCORE_THRESHOLD=45.0

# RAG & Knowledge Base Configuration
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
CHROMA_PERSIST_DIR="./chroma_db"
RAG_UPLOAD_DIR="./uploaded_knowledge_docs"
RAG_MAX_FILE_SIZE_MB=20
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.45
